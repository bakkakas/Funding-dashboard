  "copy": {
    "heroSummary": {
      "ko": "스테이블코인 결제와 금융 앱을 위해 설계된 EVM 호환 레이어1.",
      "en": "An EVM-compatible layer one designed for stablecoin payments and financial apps."
    },
    "overviewBody": {
      "ko": "Plasma One과 스테이블코인 유동성을 연결하는 네트워크. 결제 성장·보조금 의존도와 XPL 수요를 구분해 추적할 대상.",
      "en": "A network connecting Plasma One and stablecoin liquidity. Distinguish payment growth and incentives from XPL demand."
    },
    "tokenRoleValue": {
      "ko": "네이티브 거래·네트워크 보안 자산. 일부 USD₮ 전송의 수수료 면제와 일반 가스 수요는 구분 필요.",
      "en": "Native transaction and security asset. Fee-free routes for some USD₮ transfers differ from general gas demand."
    },
    "supplyValue": {
      "ko": "초기 100억 XPL. 외부 검증자·위임 도입에 연동된 발행 계획과 기본 수수료 소각.",
      "en": "Initial 10B XPL; planned emissions depend on external validators/delegation, alongside base-fee burns."
    },
    "insiderUnlock": {
      "ko": "2028-09-25까지 공식 초기 배분 기준 월별 예정치. 팀별 개별 베스팅·인플레이션 제외.",
      "en": "Initial-allocation monthly projections through 2028-09-25; individual service vesting and inflation excluded."
    },
    "unlockNote": {
      "ko": "공식 초기 배분 규칙을 2025-09-25 메인넷 기준으로 계산한 예정치. 매월 25일 생태계 3.2B/36 + 팀·투자자 5B×2/3/24. 팀별 입사일 베스팅·검증자 인플레이션·실제 청구는 제외하므로 현재 전체 언락 비율은 미확정.",
      "en": "Projected from official allocation rules and 2025-09-25 launch: monthly ecosystem 3.2B/36 plus team/investors 5B×2/3/24. Individual service vesting, validator issuance and actual claims excluded; total unlocked share unconfirmed."
    }
  },
